{
  "name": "almond.css",
  "version": "2.0.0",
  "description": "Collection of CSS styles to make simple websites look nicer.",
  "main": "dist/almond.css",
  "scripts": {
    "build": "npm run build:raw && npm run build:min && npm run build:lite",
    "build:raw": "sass src/index.scss dist/almond.css",
    "build:min": "sass --style compressed src/index.scss dist/almond.min.css",
    "build:lite": "npm run build:lite:raw && npm run build:lite:min",
    "build:lite:raw": "sass src/index.lite.scss dist/almond.lite.css",
    "build:lite:min": "sass --style compressed src/index.lite.scss dist/almond.lite.min.css",
    "test": "cypress run",
    "test:open": "cypress open",
    "watch": "sass --watch src/index.scss dist/almond.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaromontoro/almond.css.git"
  },
  "keywords": [
    "css",
    "class-less",
    "styles"
  ],
  "author": "Alvaro Montoro <alvaromontoro@gmail.com> (https://alvaromontoro.com)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/alvaromontoro/almond.css/issues"
  },
  "files": [
    "/dist"
  ],
  "homepage": "https://github.com/alvaromontoro/almond.css",
  "devDependencies": {
    "cypress": "^14.5.2",
    "husky": "^9.1.7",
    "sass": "^1.89.2"
  }
}
